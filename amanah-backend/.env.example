NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/amanah?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/amanah?sslmode=require
JWT_SIGNING_PRIVATE_KEY=
JWT_SIGNING_PUBLIC_KEY=
REFRESH_TOKEN_PEPPER=
CURSOR_SECRET=
ENABLE_REDIS=false
ENABLE_R2_UPLOADS=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MAIL_PROVIDER=disabled
MAIL_PROVIDER_API_KEY=
MAIL_SENDER_ADDRESS=
APP_LINK_ORIGIN=amanah://
GOOGLE_ALLOWED_CLIENT_IDS=
APPLE_ALLOWED_CLIENT_IDS=
GOLD_API_KEY=
EXCHANGE_RATE_API_KEY=
GOLD_QUOTE_UNIT=USD_PER_TROY_OUNCE
# Optional retained previous public keys for a short verified signing-key rotation window.
JWT_PREVIOUS_PUBLIC_KEYS={}
# Local development mail sink only. Use MAIL_PROVIDER=development to enable.
DEV_MAIL_OUTBOX_DIR=.local-mail
