EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/v1
EXPO_PUBLIC_ENVIRONMENT=development
# Native Google sign-in remains hidden until both API audiences and mobile IDs are configured.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
# Optional verified legal URLs (must be set before release).
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
# Build-time identifiers, not application secrets.
AMANAH_ANDROID_PACKAGE=
AMANAH_IOS_BUNDLE_ID=
EAS_PROJECT_ID=
