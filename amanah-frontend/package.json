{
  "name": "amanah-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "api:generate": "openapi-typescript contracts/openapi.json -o src/core/api/schema.d.ts && node scripts/generate-validators.mjs",
    "api:check": "node scripts/check-contract.mjs",
    "content:verify": "node scripts/verify-content.mjs",
    "release:check": "node scripts/release-check.mjs",
    "routes:check": "node scripts/check-routes.mjs",
    "audit:fresh": "node scripts/audit-dependencies.mjs",
    "release:evidence": "node scripts/release-evidence.mjs",
    "dependencies:check": "node scripts/dependency-compat.cjs",
    "i18n:check": "node scripts/check-localization.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "10.13.0",
    "jest": "^29.7.0",
    "jest-expo": "^58.0.12",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.0"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@tanstack/react-query": "5.104.5",
    "decimal.js": "10.6.0",
    "expo": "58.0.20",
    "expo-apple-authentication": "~58.0.2",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-router": "^58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "1.61.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "zod": "^4.6.7",
    "expo-audio": "~58.0.10",
    "expo-local-authentication": "~58.0.2",
    "expo-system-ui": "~58.0.6"
  }
}
